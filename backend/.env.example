# StudySync Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local or production environment.

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Local Docker Compose default: postgresql://postgres:postgres@localhost:5432/studysync?schema=public
# Supabase direct connection for migrations: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Supabase transaction pooler for runtime: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studysync?schema=public

# Authentication Strategy
# Options: 'supabase' (validates against Supabase JWT secret or JWKS) or 'dev' (local development)
AUTH_MODE=dev

# Supabase Auth Settings (required in production or when AUTH_MODE=supabase)
# For asymmetric JWKS verification (recommended by Supabase):
SUPABASE_URL=https://your-project-id.supabase.co
# For symmetric HS256 secret verification (legacy Supabase projects):
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder-minimum-32-chars

# Dev Authentication Secret (used ONLY in non-production when AUTH_MODE=dev)
DEV_AUTH_SECRET=local-studysync-dev-jwt-secret-do-not-use-in-prod-32c
