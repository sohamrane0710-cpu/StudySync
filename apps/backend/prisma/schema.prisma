// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum TimerStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MEMBER
}

enum RoomRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// MODELS

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  username            String?  @unique @db.Citext
  email               String   @unique @db.Citext
  displayName         String?
  avatarUrl           String?
  bio                 String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationships
  credential         Credential?
  sessions           Session[]
  accounts           Account[]
  timerModes         TimerMode[]
  timerSessions      TimerSession[]
  studySessions      StudySession[]
  dailyTargets       DailyTarget[]
  labels             Label[]
  roomsCreated       StudyRoom[]
  roomMemberships    RoomMember[]
  roomParticipations RoomParticipation[]
  groupsCreated      Group[]
  groupMemberships   GroupMember[]
  communitiesCreated Community[]
  invitesSent        Invite[]            @relation("SentInvites")
  invitesReceived    Invite[]            @relation("ReceivedInvites")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model TimerMode {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String
  description  String?
  stagesConfig Json
  loop         Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  timerSessions TimerSession[]

  @@index([userId])
}

model TimerSession {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String?     @db.Uuid // Optional to support shared room timers
  roomId            String?     @db.Uuid // Links to a StudyRoom for shared timers
  timerModeId       String      @db.Uuid
  status            TimerStatus @default(PENDING)
  currentStageIndex Int         @default(0)
  startedAt         DateTime?
  targetEndTime     DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  room               StudyRoom?          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  timerMode          TimerMode           @relation(fields: [timerModeId], references: [id], onDelete: Restrict)
  studySessions      StudySession[]
  roomParticipations RoomParticipation[]

  @@index([userId])
  @@index([roomId])
  @@index([timerModeId])
}

model RoomParticipation {
  id             String    @id @default(uuid()) @db.Uuid
  roomId         String    @db.Uuid
  timerSessionId String    @db.Uuid
  userId         String    @db.Uuid
  startedAt      DateTime
  endedAt        DateTime?

  room         StudyRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  timerSession TimerSession @relation(fields: [timerSessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([timerSessionId])
  @@index([userId])
}

model StudySession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  timerSessionId  String?  @db.Uuid
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())

  user                 User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  timerSession         TimerSession?                     @relation(fields: [timerSessionId], references: [id], onDelete: SetNull)
  labels               Label[]
  groupContributions   StudySessionGroupContribution[]
  labelGroupSelections StudySessionLabelGroupSelection[]

  @@index([userId])
  @@index([timerSessionId])
}

model DailyTarget {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  date          DateTime @db.Date
  targetSeconds Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions        StudySession[]
  associations         LabelAssociation[]
  labelGroupSelections StudySessionLabelGroupSelection[]

  @@unique([userId, name])
}

model GroupLabel {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group                Group                             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  associations         LabelAssociation[]
  dimensions           ContributionDimension[]
  labelGroupSelections StudySessionLabelGroupSelection[]

  @@unique([groupId, name])
}

model LabelAssociation {
  id           String   @id @default(uuid()) @db.Uuid
  labelId      String   @db.Uuid // Personal label
  groupLabelId String   @db.Uuid // Group label
  createdAt    DateTime @default(now())

  label      Label      @relation(fields: [labelId], references: [id], onDelete: Cascade)
  groupLabel GroupLabel @relation(fields: [groupLabelId], references: [id], onDelete: Cascade)

  @@unique([labelId, groupLabelId])
}

model StudySessionGroupContribution {
  id              String   @id @default(uuid()) @db.Uuid
  studySessionId  String   @db.Uuid
  groupId         String   @db.Uuid
  durationSeconds Int // Counted ONCE per group per session
  createdAt       DateTime @default(now())

  studySession StudySession            @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dimensions   ContributionDimension[]

  @@unique([studySessionId, groupId])
  @@index([groupId])
}

model StudySessionLabelGroupSelection {
  id             String   @id @default(uuid()) @db.Uuid
  studySessionId String   @db.Uuid
  labelId        String   @db.Uuid
  groupLabelId   String   @db.Uuid
  isIncluded     Boolean // True means explicitly included, false means explicitly excluded
  createdAt      DateTime @default(now())

  studySession StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)
  groupLabel   GroupLabel   @relation(fields: [groupLabelId], references: [id], onDelete: Cascade)

  @@unique([studySessionId, labelId, groupLabelId])
  @@index([studySessionId])
  @@index([labelId])
  @@index([groupLabelId])
}

model ContributionDimension {
  id                     String  @id @default(uuid()) @db.Uuid
  contributionId         String  @db.Uuid
  groupLabelId           String? @db.Uuid // Optional in case GroupLabel is later deleted
  groupLabelNameSnapshot String // Immutable snapshot of the name

  contribution StudySessionGroupContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  groupLabel   GroupLabel?                   @relation(fields: [groupLabelId], references: [id], onDelete: SetNull)

  @@unique([contributionId, groupLabelNameSnapshot]) // Prevent duplicate dimensions in a single contribution
}

model StudyRoom {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  visibility  RoomVisibility @default(PUBLIC)
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  roomMembers        RoomMember[]
  timerSessions      TimerSession[]
  roomParticipations RoomParticipation[]

  @@index([createdById])
}

model RoomMember {
  roomId   String   @db.Uuid
  userId   String   @db.Uuid
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())

  room StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model Group {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  visibility  GroupVisibility @default(PRIVATE)
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy       User                            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  groupMembers    GroupMember[]
  communityGroups CommunityGroup[]
  invites         Invite[]
  groupLabels     GroupLabel[]
  contributions   StudySessionGroupContribution[]

  @@index([createdById])
}

model GroupMember {
  groupId  String    @db.Uuid
  userId   String    @db.Uuid
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Community {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  communityGroups CommunityGroup[]

  @@index([createdById])
}

model CommunityGroup {
  communityId String @db.Uuid
  groupId     String @db.Uuid

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([communityId, groupId])
  @@index([groupId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  senderId    String       @db.Uuid
  recipientId String       @db.Uuid
  groupId     String       @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  sender    User  @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User  @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([groupId])
}

model Credential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
