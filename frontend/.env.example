# StudySync Frontend Environment Configuration

# Backend REST Base URL
VITE_API_URL=http://localhost:3000/api/v1

# Backend Socket.IO Collaboration Server URL
VITE_WS_URL=http://localhost:3000

# Supabase Public Project Configuration (Public Anon Key only, NEVER service role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Local Auth Mode ('auto', 'dev', 'supabase')
# 'auto': uses Supabase if credentials are provided; allows local dev token fallback
VITE_AUTH_MODE=auto

# Local Development Token (Generated via `npm run dev:token` in backend/)
# Pre-configures the token used by "Quick Local Developer Sign-In"
VITE_DEV_TOKEN=
